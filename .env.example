# Copy to .env (git-ignored) and fill in. Load with: uv run --env-file .env python run_cases.py ...
# Never commit real keys. Use a key whose project's data-handling terms the owner has confirmed
# (specs/assumptions.md A-10, SEC-14).

LLM_PROVIDER=gemini                # gemini | groq | fake (fake = offline tests/CI); groq per owner decision OD-26
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite   # owner decision OD-15 (configurable)
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite  # OD-15; empty disables; same key/project only (2.5 is incompatible)
GOOGLE_API_KEY=                    # the ONLY key source the app reads (an inherited GEMINI_API_KEY is ignored); owner-managed
GEMINI_THINKING_LEVEL=minimal

LLM_TIMEOUT_S=10                   # Gemini API minimum request deadline is 10 s
CASE_DEADLINE_S=30
LLM_MAX_ATTEMPTS=3                  # primary → fallback → one same-model retry (iteration 1)
LLM_MAX_OUTPUT_TOKENS=600
INPUT_CHAR_CAP=2000
MAX_LLM_CALLS_PER_BATCH=2000
DATA_DIR=data

# --- GroqCloud (OD-26, free plan). Each provider reads exactly ONE key variable (AR-09 generalised).
GROQ_API_KEY=                      # the ONLY key the app reads when LLM_PROVIDER=groq; enable Zero Data Retention in Groq Data Controls
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b   # separate free-plan quota bucket, same org/data terms
GROQ_REASONING_EFFORT=low
GROQ_TPM_BUDGET=8000               # free plan 8K tokens/min per model; client-side pacing (0 = off)
GROQ_MIN_CALL_INTERVAL_S=0
# For paced Groq eval runs raise the case deadline (pacing waits count against it), e.g. CASE_DEADLINE_S=180
