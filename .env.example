# Copy to .env (git-ignored) and fill in. Load with: uv run --env-file .env python run_cases.py ...
# Never commit real keys. The Gemini project MUST have billing enabled (paid terms) before
# assessment material is sent to it — see specs/assumptions.md A-10.

LLM_PROVIDER=gemini                # gemini | fake (fake = offline tests/CI)
GEMINI_PRIMARY_MODEL=              # REQUIRED for gemini (no default). Owner decision OD-15: a 3.x Flash-Lite ID
GEMINI_FALLBACK_MODEL=             # optional; the other 3.x Flash-Lite (2.5 is incompatible: no tools + JSON schema)
GOOGLE_API_KEY=                    # key from a BILLED Google AI Studio / Cloud project
GEMINI_THINKING_LEVEL=minimal

LLM_TIMEOUT_S=8
LLM_MAX_ATTEMPTS=2
LLM_MAX_OUTPUT_TOKENS=600
INPUT_CHAR_CAP=2000
MAX_LLM_CALLS_PER_BATCH=2000
DATA_DIR=data
