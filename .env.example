# Copy to .env (git-ignored), set ONE provider and its key, then load it:
#   set -a; . ./.env; set +a      (or: uv run --env-file .env python3 run_cases.py ...)
# Never commit real keys. Each provider reads ONLY its own key variable.

LLM_PROVIDER=groq                  # groq | gemini | fake (fake = offline, no key)

# --- GroqCloud (used for the final runs)
GROQ_API_KEY=                      # your key; enable Zero Data Retention in Groq Data Controls
# GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b     # separate free-plan quota bucket
# GROQ_REASONING_EFFORT=low
# GROQ_TPM_BUDGET=8000             # client-side pacing for the free plan (0 = off)

# --- Google Gemini
GOOGLE_API_KEY=                    # only read when LLM_PROVIDER=gemini (an inherited GEMINI_API_KEY is ignored)
# GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_THINKING_LEVEL=minimal

# --- Optional overrides (leave commented to use provider-appropriate defaults)
# CASE_DEADLINE_S=180              # default 180 s for paced Groq runs, 30 s otherwise
# LLM_MAX_OUTPUT_TOKENS=1024       # default 1024 for groq (reasoning tokens count), 600 otherwise
# LLM_TIMEOUT_S=30                 # per attempt; Gemini enforces a 10 s minimum
# LLM_MAX_ATTEMPTS=3               # primary -> fallback -> one same-model retry
# INPUT_CHAR_CAP=2000
# MAX_LLM_CALLS_PER_BATCH=2000
# DATA_DIR=data
